generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum UserStatus {
  ACTIVE
  INACTIVE
  BLOCKED
}

enum DroneStatus {
  AVAILABLE
  IN_MISSION
  MAINTENANCE
  OFFLINE
}

enum MissionStatus {
  PENDING
  RUNNING
  COMPLETED
  CANCELLED
}

enum AlertLevel {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

model Role {

  id          Int      @id @default(autoincrement())

  name        String   @unique

  description String?

  users       User[]

  createdAt   DateTime @default(now())

  updatedAt   DateTime @updatedAt

}

model User {

  id              Int      @id @default(autoincrement())

  firstName       String

  lastName        String

  email           String   @unique

  password        String

  phone           String?

  status          UserStatus @default(ACTIVE)

  roleId          Int

  role            Role @relation(fields:[roleId],references:[id])

  drones          Drone[]

  maintenances    Maintenance[]

  createdAt       DateTime @default(now())

  updatedAt       DateTime @updatedAt

  deletedAt       DateTime?

}

model Drone {

  id              Int @id @default(autoincrement())

  code            String @unique

  serial          String @unique

  model           String

  manufacturer    String

  battery         Int

  firmware        String?

  status          DroneStatus @default(AVAILABLE)

  userId          Int?

  operator        User? @relation(fields:[userId],references:[id])

  missions        Mission[]

  alerts          Alert[]

  maintenances    Maintenance[]

  createdAt       DateTime @default(now())

  updatedAt       DateTime @updatedAt

}

model Mission {

  id              Int @id @default(autoincrement())

  name            String

  description     String?

  location        String

  latitude        Float

  longitude       Float

  altitude        Float

  status          MissionStatus @default(PENDING)

  droneId         Int

  drone           Drone @relation(fields:[droneId],references:[id])

  createdAt       DateTime @default(now())

  updatedAt       DateTime @updatedAt

}

model Alert {

  id              Int @id @default(autoincrement())

  title           String

  description     String

  level           AlertLevel

  attended        Boolean @default(false)

  droneId         Int

  drone           Drone @relation(fields:[droneId],references:[id])

  createdAt       DateTime @default(now())

}

model Maintenance {

  id              Int @id @default(autoincrement())

  description     String

  startDate       DateTime

  endDate         DateTime?

  droneId         Int

  technicianId    Int

  drone           Drone @relation(fields:[droneId],references:[id])

  technician      User @relation(fields:[technicianId],references:[id])

  createdAt       DateTime @default(now())

}
