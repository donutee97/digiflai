# ==========================================================
# DigiflAi API - variables de entorno (EJEMPLO)
#
# Copiar y ajustar:
#   cp .env.example .env
#
# NUNCA subir el archivo .env real a GitHub.
# ==========================================================

# --- Servidor ---
PORT=4000
NODE_ENV=development

# --- Frontend (CORS + WebSocket) ---
# Vite corre por defecto en 5173. Puedes permitir varios orígenes separados por coma:
#   FRONTEND_URL=http://localhost:5173,http://192.168.1.50:5173
FRONTEND_URL=http://localhost:5173

# --- PostgreSQL (Prisma) ---
# Opción A (recomendada si ya tienes PostgreSQL local, como DBeaver): puerto 5432.
#   DATABASE_URL="postgresql://postgres:TU_CLAVE@localhost:5432/digiflai?schema=public"
#
# Opción B (solo si usas el contenedor postgres de docker-compose): puerto 5433.
#   El contenedor publica 5433 para no chocar con el PostgreSQL local.
DATABASE_URL="postgresql://postgres:admin_db1@localhost:5433/digiflai?schema=public"
#
# Si la clave tiene @ : / # % u otros caracteres reservados, codifícala en URL
# (por ejemplo: @ -> %40).

# --- MongoDB (Mongoose) ---
# El backend lee MONGO_URL (no MONGODB_URI).
MONGO_URL="mongodb://localhost:27017/digiflai_telemetry"

# --- JWT ---
# Generar una clave segura:
#   openssl rand -hex 32
JWT_SECRET=change-me-run-openssl-rand-hex-32
JWT_EXPIRES_IN=8h

# --- MQTT (EMQX) ---
MQTT_BROKER=mqtt://localhost:1883

# --- Logs ---
LOG_LEVEL=info

# --- Límites de peticiones (útil para demostraciones con varios visitantes) ---
# Peticiones por IP cada 15 minutos para /api/ y para el login.
RATE_LIMIT_MAX=1000
AUTH_RATE_LIMIT_MAX=200
