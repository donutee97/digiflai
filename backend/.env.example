# ==========================================================
# DigiflAi API - variables de entorno (EJEMPLO)
#
# Copiar y ajustar:
#   cp .env.example .env
#
# NUNCA subir el archivo .env real a GitHub.
# ==========================================================

# --- Servidor ---
PORT=4000
NODE_ENV=development

# --- Frontend (CORS + WebSocket) ---
# Vite corre por defecto en 5173. Puedes permitir varios orígenes separados por coma:
#   FRONTEND_URL=http://localhost:5173,http://192.168.1.50:5173
FRONTEND_URL=http://localhost:5173

# --- PostgreSQL (Prisma) ---
# El contenedor publica el puerto 5433 para no chocar con un PostgreSQL local.
DATABASE_URL="postgresql://postgres:admin_db1@localhost:5433/digiflai?schema=public"

# --- MongoDB (Mongoose) ---
# El backend lee MONGO_URL (no MONGODB_URI).
MONGO_URL="mongodb://localhost:27017/digiflai_telemetry"

# --- JWT ---
# Generar una clave segura:
#   openssl rand -hex 32
JWT_SECRET=change-me-run-openssl-rand-hex-32
JWT_EXPIRES_IN=8h

# --- MQTT (EMQX) ---
MQTT_BROKER=mqtt://localhost:1883

# --- Logs ---
LOG_LEVEL=info
