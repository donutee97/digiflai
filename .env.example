# ==========================================================
# DigiflAi - variables para docker compose (EJEMPLO)
#
# Copiar a .env en la raíz del repo:
#   cp .env.example .env
#
# Este archivo NO es el .env del backend.
# El backend tiene el suyo en backend/.env
# ==========================================================

# --- Puertos publicados en el host ---
# PostgreSQL del contenedor (5433 para no chocar con un PostgreSQL local en 5432)
POSTGRES_PORT=5433
# Frontend servido por Nginx. Si usas `npm run dev`, Vite ocupa 5173;
# en ese caso usa otro puerto aquí (por ejemplo 8080).
FRONTEND_PORT=5173

# --- PostgreSQL del contenedor ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=admin_db1
POSTGRES_DB=digiflai

# --- JWT (generar con: openssl rand -hex 32) ---
JWT_SECRET=change-me-run-openssl-rand-hex-32

# --- Origen permitido por CORS / Socket.IO de la API ---
# Debe coincidir con la URL del frontend en el NAVEGADOR.
FRONTEND_URL=http://localhost:5173

# --- Frontend: URLs que Vite incrusta en el bundle al compilar ---
# Deben ser accesibles desde el navegador, no desde la red de Docker.
VITE_API_URL=http://localhost:4000/api
VITE_SOCKET_URL=http://localhost:4000
